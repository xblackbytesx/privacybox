http:
  port: 80
  baseURL: "/"
  # Traefik is the only way in, so its X-Forwarded-* headers can be trusted.
  trustProxyHeaders: true
server:
  database:
    path: "/home/filebrowser/data/database.sqlite"
    # First v2 start after a v1 upgrade only, see docs/filebrowser.md.
    # migrateFrom: "/home/filebrowser/data/database.db.old"
  logging:
    - levels: "info|warning|error"
  sources:
    - path: "/data"
      config:
        defaultEnabled: true
        defaultPermissions:
          modify: false
userDefaults:
  preview:
    image: true
    popup: true
    video: false
    office: false
    highQuality: false
  ui:
    darkMode: true
  listing:
    singleClick: false
  account:
    disableSettings: false
    permissions:
      admin: false
      share: false
      api: false
auth:
  adminUsername: admin
