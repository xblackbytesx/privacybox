DOMAIN=privacy.box
SUBDOMAIN=turnstone
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Pin the ghcr.io image once you are running. `latest` is fine to start with.
TURNSTONE_IMAGE_TAG=latest

# Postgres password. It is also substituted into TURNSTONE_DB_URL, so keep it to
# characters that are safe in a URL (letters, digits, dot, dash, underscore) or
# percent-encode it there.
DB_USER_PASS=secret

# Signing secret shared by every Turnstone service. Minimum 32 characters, the
# process exits at startup if it is shorter. Generate with:
#   openssl rand -hex 32
TURNSTONE_JWT_SECRET=

# Everything the agent can read and write, mounted at /workspace. Create it
# first and give it to the image's own uid (1000 unless it changed upstream).
TURNSTONE_WORKSPACE_DIR=/media/storage/docker/turnstone/workspace

# Bootstrap model endpoint. Leave both EMPTY unless you know you want this.
# Given a base URL and no MODEL, the node probes the endpoint at boot, picks one
# model itself and synthesizes an in-memory "default" alias. That is not a model
# definition: it never reaches the database, so the console coordinator still
# reports "No model definitions found" while the node shows a model. Real
# backends go in Admin -> Models. See docs/turnstone.md.
LLM_BASE_URL=
OPENAI_API_KEY=

# Backend for the web_search tool, used by local models (commercial providers use
# their own search and never hit this). Points at the searxng app in this repo,
# which already carries the `formats: [html, json]` its JSON API needs. Keep
# SEARXNG_LIMITER=false there, the limiter would 429 these calls. Leave empty to
# turn web search off.
TURNSTONE_SEARXNG_URL=https://search.privacy.box

# Node name shown in the dashboard. Only worth changing if you add more nodes.
TURNSTONE_NODE_ID=node-1

# Channel gateway, only read when you uncomment that service.
# TURNSTONE_DISCORD_TOKEN=
# TURNSTONE_DISCORD_GUILD=0
# TURNSTONE_SLACK_TOKEN=xoxb-
# TURNSTONE_SLACK_APP_TOKEN=xapp-

# Local image build. Only read on hosts where you copied
# docker-compose.override.example.yml to docker-compose.override.yml, which is
# how an arm64 host gets an image at all. update-source.sh maintains the clone.
# Pin a release tag rather than a branch: this container runs an agent with a
# shell, so upstream should move when you decide it does, not overnight.
TURNSTONE_SRC_DIR=/media/storage/docker/turnstone/src
TURNSTONE_SRC_REF=v1.8.0
