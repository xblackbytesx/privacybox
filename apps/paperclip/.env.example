DOMAIN=privacy.box
SUBDOMAIN=paperclip
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Must own the data directory. Never 0.
PUID=1000
PGID=1000

DB_USER_PASS=secret

# openssl rand -hex 32
BETTER_AUTH_SECRET=secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=secret

# No version tags upstream. Pin to a sha tag to hold the instance still.
# PAPERCLIP_IMAGE_TAG=sha-59e29af

# authenticated | local_trusted
# PAPERCLIP_DEPLOYMENT_MODE=authenticated

# public | private. private is for NetBird or LAN only reachability.
# PAPERCLIP_DEPLOYMENT_EXPOSURE=public

# Comma-separated. A NetBird alias goes here.
# PAPERCLIP_ALLOWED_HOSTNAMES=

# Model routing. Inherited-env fallback only, and Codex ignores OPENAI_API_KEY
# set here by design. See docs/paperclip.md.

# Through LiteLLM, recommended. Add OpenRouter as a provider there.
# ANTHROPIC_BASE_URL=https://litellm.privacy.box
# ANTHROPIC_API_KEY=sk-litellm-virtual-key
# OPENAI_BASE_URL=https://litellm.privacy.box/v1
# OPENAI_API_KEY=sk-litellm-virtual-key

# Only when the gateway hostname resolves to a private address. Exact origin.
# PAPERCLIP_HTTP_ADAPTER_PRIVATE_ENDPOINT_ALLOWLIST=https://litellm.privacy.box

# No gateway. OpenRouter is OpenAI-compatible, so it needs no new variable.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-v1-...

# No gateway, straight to a provider.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
