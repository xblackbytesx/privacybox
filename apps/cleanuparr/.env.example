# DOMAIN, SUBDOMAIN and CERT_RESOLVER are only used by docker-compose.yml
DOMAIN=privacy.box
SUBDOMAIN=cleanuparr
CERT_RESOLVER=cloudflare-dns

# On TrueNAS this is a pool dataset path, e.g. /mnt/tank/docker
DOCKER_ROOT=/media/storage/docker

# Must own the config directory. TrueNAS's built-in apps user is 568:568.
PUID=1000
PGID=1000

TIMEZONE=Europe/Amsterdam
