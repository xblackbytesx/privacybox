DOMAIN=privacy.box
SUBDOMAIN=papra
CERT_RESOLVER=cloudflare-dns

PUID=1000
PGID=1000

DOCKER_ROOT=/media/storage/docker
DOCUMENTS_PATH="/media/storage/documents/papra/documents"

# Drop folder. Papra only picks up files inside a subfolder named after an
# organisation id, so the actual drop path is $INGESTION_PATH/org_<id>/, with
# the id taken from the organisation URL in the web UI.
INGESTION_PATH="/media/storage/documents/papra/ingestion"

# Generate a secret with `openssl rand -hex 48`
AUTH_SECRET=

# Sign up is open while this is true. Create your account, then set it to
# false and recreate the container.
REGISTRATION_ENABLED=true

# Maximum upload size in bytes. Default upstream is 25MB, this is 100MB.
MAX_UPLOAD_SIZE=104857600

# Tesseract language codes for OCR, comma separated.
OCR_LANGUAGES=eng,nld
