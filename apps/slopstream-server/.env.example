DOMAIN=privacy.box
SUBDOMAIN=slopstream
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# A release (0.1.0), a series (0.1) or latest
SLOPSTREAM_VERSION=latest

DB_PASSWORD=secret

# generate using `openssl rand -base64 32`
# Encrypts the Floatplane and Sauce+ sessions at rest. Keep a copy with your
# backups: without it everyone has to sign in to those services again.
SLOPSTREAM_SECRET_KEY=

# The address devices use, shown on a TV while it pairs.
# docker-compose.yml defaults to https://SUBDOMAIN.DOMAIN; set it for the alt file.
SLOPSTREAM_PUBLIC_URL=

# Fetch the video lists here so devices find them ready (0.2.0 and later)
SLOPSTREAM_FEEDS=true

# Optional: set to "false" only if running without HTTPS (not recommended for production)
SLOPSTREAM_COOKIE_SECURE=true
