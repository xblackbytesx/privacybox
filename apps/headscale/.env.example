DOMAIN=privacy.box
SUBDOMAIN=hs
HEADPLANE_SUBDOMAIN=hp
CERT_RESOLVER=cloudflare-dns

TIMEZONE=Europe/Amsterdam

DOCKER_ROOT=/media/storage/docker

# Basic auth in front of Headplane. Any non-empty value enables it, so comment
# the line out to disable rather than setting it to false or 0. Headplane's own
# auth lives in its host config.yaml, which this repo cannot see, and the
# container mounts the Docker socket. Leave this on unless you have confirmed
# Headplane itself requires a login.
HEADPLANE_BASIC_AUTH=1
