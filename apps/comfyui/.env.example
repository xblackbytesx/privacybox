# Wherever container data lives on this box.
DOCKER_ROOT=/media/storage/docker

# Tag of ghcr.io/xblackbytesx/comfy-arc, built from /workspace/comfy-arc.
COMFYUI_IMAGE_TAG=latest

# Own generated images as the account that owns the dataset, instead of root.
# Check with: stat -c '%u:%g' $DOCKER_ROOT/comfyui/user-storage/output
PUID=950
PGID=950

# Keep the model in VRAM between runs, so a generation finishes quickly and
# llama-swap gets the card back sooner. Turning this off would only make each
# generation longer and move the memory into RAM.
COMFY_SMART_MEMORY=on

# Release models, VRAM and RAM after this many seconds with an empty queue.
# Short here because llama-swap shares the card: if one of its models ever
# fails to load while ComfyUI idles, lower this or call /free by hand.
COMFY_IDLE_UNLOAD=300

# Node result cache: classic, none (least RAM), or lru:N.
# COMFY_CACHE=classic

# Hold VRAM back for other software, in GB. RESERVE is ComfyUI's own
# reservation; HEADROOM also counts what other processes are using.
# COMFY_RESERVE_VRAM=2
# COMFY_VRAM_HEADROOM=2

# Extra ComfyUI flags, verbatim. Only needed if a workflow puts a text encoder
# on the CPU: ComfyUI stores those in fp16, which x86 has no fast path for, so
# the run looks hung. bf16 costs the same memory and runs natively.
# COMFY_EXTRA_ARGS=--bf16-text-enc
