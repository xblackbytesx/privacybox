DOMAIN=privacy.box
SUBDOMAIN=matrix
CERT_RESOLVER=transip-dns

PUID=1000
PGID=1000
TIMEZONE=Europe/Amsterdam

DB_USER_PASS=secret

EXTERNAL_IP=111.666.111.666

# A way to generate easily: openssl rand -hex 32
TURN_SECRET=secret

# openssl rand -hex 16
LIVEKIT_API_KEY=secret

# openssl rand -hex 32
LIVEKIT_API_SECRET=secret

# Matrix Authentication Service takes no configuration from here. It reads a
# YAML file (mas-config.yaml) and the database DSN, matrix.secret and signing
# keys all live inside it. See docs/synapse.md.

DOCKER_ROOT=/media/storage/docker
