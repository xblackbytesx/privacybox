# Both endpoints are the single public hostname. Traefik splits the paths:
# / to the dashboard, /api /relay /ws-proxy /oauth2 and the two gRPC prefixes
# to netbird-server.
NETBIRD_MGMT_API_ENDPOINT=https://netbird.privacy.box
NETBIRD_MGMT_GRPC_API_ENDPOINT=https://netbird.privacy.box

# Embedded IdP. netbird-server ships Dex and serves it under /oauth2, so there
# is no external identity provider to configure and AUTH_CLIENT_SECRET stays
# empty. The combined server image cannot use an external IdP at all: Dex is
# always enabled and overrides any OIDC settings you put here.
AUTH_AUTHORITY=https://netbird.privacy.box/oauth2
AUTH_AUDIENCE=netbird-dashboard
AUTH_CLIENT_ID=netbird-dashboard
AUTH_CLIENT_SECRET=
USE_AUTH0=false
AUTH_SUPPORTED_SCOPES=openid profile email groups
AUTH_REDIRECT_URI=/nb-auth
AUTH_SILENT_REDIRECT_URI=/nb-silent-auth

# Traefik terminates TLS, so the dashboard's own certificate handling is off.
NGINX_SSL_PORT=443
LETSENCRYPT_DOMAIN=none
