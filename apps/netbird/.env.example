DOMAIN=privacy.box
SUBDOMAIN=netbird
CERT_RESOLVER=cloudflare-dns

# NetBird's own default is 3478, which is already taken on this host: synapse
# runs coturn on the host network on 3478/udp, and headscale publishes 3479/udp
# for its embedded DERP relay. Keep these three distinct.
STUN_PORT=3480

DOCKER_ROOT=/media/storage/docker
