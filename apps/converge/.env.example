DOMAIN=privacy.box
SUBDOMAIN=converge
CERT_RESOLVER=transip-dns

DOCKER_ROOT=/media/storage/docker

# A release (0.1.0), a series (0.1) or latest
CONVERGE_VERSION=latest

DB_PASSWORD=secret

# generate using `head -c 32 /dev/urandom | base64`
# Encrypts the connection credentials (provider API keys) at rest. Keep a
# copy with your backups: without it every connection key has to be entered
# again. Never change it once a connection is saved.
CONVERGE_SECRET_KEY=

# The address people use, for invite links.
# docker-compose.yml defaults to https://SUBDOMAIN.DOMAIN.
CONVERGE_PUBLIC_URL=

# Prometheus /metrics on 9090, never routed by Traefik. "off" disables it.
# Set a token when the port is published for a Prometheus on another host.
CONVERGE_METRICS_BIND=0.0.0.0:9090
CONVERGE_METRICS_TOKEN=
