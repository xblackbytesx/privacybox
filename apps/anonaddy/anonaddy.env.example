TZ=Europe/Amsterdam
PUID=1000
PGID=1000

MEMORY_LIMIT=256M
UPLOAD_MAX_SIZE=16M
OPCACHE_MEM_SIZE=128
REAL_IP_FROM=0.0.0.0/32
REAL_IP_HEADER=X-Forwarded-For
LOG_IP_VAR=remote_addr

APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

ANONADDY_RETURN_PATH=bounces@privacy.box
ANONADDY_ADMIN_USERNAME=addy
ANONADDY_ENABLE_REGISTRATION=true
ANONADDY_DOMAIN=privacy.box
ANONADDY_ALL_DOMAINS=example.com
ANONADDY_HOSTNAME=mail.privacy.box
ANONADDY_DNS_RESOLVER=127.0.0.1
ANONADDY_SECRET=
ANONADDY_LIMIT=200
ANONADDY_BANDWIDTH_LIMIT=104857600
ANONADDY_NEW_ALIAS_LIMIT=10
ANONADDY_ADDITIONAL_USERNAME_LIMIT=3

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1,10.10.10.6,privacy.box,privacy.box:443

MAIL_FROM_NAME=addy.io
MAIL_FROM_ADDRESS=addy@privacy.box

POSTFIX_DEBUG=false
# POSTFIX_SMTPD_TLS=false
# POSTFIX_SMTP_TLS=false

POSTFIX_INET_PROTOCOLS=ipv4
POSTFIX_RELAYHOST=smtp.privacy.box:587
POSTFIX_RELAYHOST_AUTH_ENABLE=true
POSTFIX_RELAYHOST_USERNAME=privacybox@privacy.box
POSTFIX_RELAYHOST_PASSWORD=secret
POSTFIX_SMTP_TLS=true

# Optional: rspamd. Off by default, and off is a complete working setup.
#
# Turning it on adds content filtering, bayes and greylisting on top of the
# Spamhaus checks postfix already does, and it is also what makes replying from
# an alias, quarantine, and DKIM plus ARC signing work at all. The cost is DKIM
# keys and DNS records, plus a greylisting delay on first contact from any new
# sender.
#
# To enable: uncomment below and follow docs/anonaddy.md for the DNS side.
#
# RSPAMD_ENABLE=true
# RSPAMD_WEB_PASSWORD=secret
# RSPAMD_SECURE_IP=127.0.0.1/32
#
# Port 25 is published through Docker, so inbound connections can look local to
# rspamd, which then skips DMARC and SPF. That silently breaks replying from an
# alias, the one feature rspamd is most needed for. See docs/anonaddy.md.
# RSPAMD_NO_LOCAL_ADDRS=true
#
# Greylisting defers first contact from unknown senders by a few minutes. Very
# effective, but it also delays the confirmation mail from a form you just
# handed a fresh alias to. Set false if that trade is wrong for you.
# RSPAMD_GREYLIST_ENABLE=true
#
# Selector for the DKIM record: <selector>._domainkey.ANONADDY_DOMAIN
# ANONADDY_DKIM_SELECTOR=default

# Optional, independent of rspamd. Postfix already rejects on zen/dbl.spamhaus.org
# before rspamd would see the mail. Public queries from datacenter IPs get
# rate-limited or blocked, which fails open, so a free personal DQS key is worth it.
# POSTFIX_SPAMHAUS_DQS_KEY=
