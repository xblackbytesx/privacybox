DOMAIN=privacy.box
SUBDOMAIN=wordwarz
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# A release (0.1.0), a series (0.1) or latest
WORDWARZ_VERSION=latest

DB_PASSWORD=secret

# The address the phones use; invite and device-link QR codes point here.
# docker-compose.yml defaults to https://SUBDOMAIN.DOMAIN; set it for the alt file.
WORDWARZ_PUBLIC_URL=

# UnifiedPush servers the apps may register on (host names, comma-separated).
# The server only ever POSTs to these. Empty: no push notifications.
WORDWARZ_PUSH_HOSTS=ntfy.privacy.box

# Optional: set to "false" only if running without HTTPS (not recommended for production)
WORDWARZ_COOKIE_SECURE=true
