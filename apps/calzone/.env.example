DOMAIN=privacy.box
SUBDOMAIN=calzone
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# A release (0.1.0), a series (0.1) or latest
CALZONE_VERSION=latest

# generate using `openssl rand -hex 24`
DB_PASSWORD=

# generate using `head -c 32 /dev/urandom | base64`
# Encrypts the two-factor secrets at rest. Keep it with your backups:
# without it everyone has to set two-factor sign-in up again.
CALZONE_SECRET_KEY=

# Who must use two-factor sign-in: everyone (default here, the server is
# public), admins or optional.
CALZONE_TWO_FACTOR=everyone

# The address people and devices use.
# docker-compose.yml defaults to https://SUBDOMAIN.DOMAIN.
CALZONE_PUBLIC_URL=

# The CalDAV/CardDAV door for DAVx5 and Thunderbird: on or off.
CALZONE_DAV=on
