base-url: "https://ntfy.privacy.box"
cache-file: "/var/cache/ntfy/cache.db"
cache-startup-queries: |
    pragma journal_mode = WAL;
    pragma synchronous = normal;
    pragma temp_store = memory;
    pragma busy_timeout = 15000;
behind-proxy: true
auth-file: "/var/cache/ntfy/auth.db"
auth-default-access: "deny-all"
# enable-login: true
# require-login: true
attachment-cache-dir: "/var/cache/ntfy/attachments"

# USERS, ACCESS AND TOKENS are declared below rather than created with the CLI.
# ntfy re-applies all three lists on every start, and anything removed from them
# is deleted from auth.db on the next restart. The CLI cannot change or delete
# what is declared here. auth-access and auth-tokens may only name users from
# auth-users (or `everyone`). Setup and migration: docs/ntfy.md.
#
# The PASTE_BCRYPT_HASH_HERE and tk_PASTE_TOKEN_HERE placeholders are invalid
# on purpose: ntfy refuses to start until every one is replaced, so a copied
# example never runs with a known secret.
# This file now holds secrets: keep it chmod 600.

# <name>:<bcrypt-hash>:<role>, role is admin or user.
# Hash: docker run --rm -it binwiederhier/ntfy user hash
# App users only ever authenticate with a token. Give them a long random
# password, hash it and discard it.
auth-users:
  - "admin:PASTE_BCRYPT_HASH_HERE:admin"
  - "phone:PASTE_BCRYPT_HASH_HERE:user"
  - "odysseus:PASTE_BCRYPT_HASH_HERE:user"
  - "cleanuparr:PASTE_BCRYPT_HASH_HERE:user"

# <user>:<topic-pattern>:<rw|ro|wo|deny>. Admins already have full access and
# must not appear here, or ntfy refuses to start. Pattern per app: the app may
# only publish to its own topic, the phone may only subscribe to it.
auth-access:
  # UnifiedPush (Element-X via Matrix push gateway, plus any other UP apps).
  # Allows the gateway, an unauthenticated external publisher, to POST to
  # topics whose name starts with `up`. Never name an app topic `up...`.
  - "everyone:up*:wo"
  - "phone:up*:ro"
  - "odysseus:odysseus:wo"
  - "phone:odysseus:ro"
  - "cleanuparr:cleanuparr-alerts:wo"
  - "phone:cleanuparr-alerts:ro"

# <user>:<token>[:<label>], the label may not contain a colon.
# New token: docker run --rm binwiederhier/ntfy token generate
# A tk_ token already issued with the CLI can be pasted here unchanged and keeps
# working, so the app holding it needs no change.
auth-tokens:
  - "odysseus:tk_PASTE_TOKEN_HERE:Odysseus reminders"
  - "cleanuparr:tk_PASTE_TOKEN_HERE:Cleanuparr"

# Per-visitor (per-IP) rate limits. The Matrix push gateway is a single IP
# that publishes all your Matrix pushes, so the burst/daily caps must fit
# realistic catch-up bursts (e.g. phone leaves airplane mode and 20 rooms
# flush at once). Defaults below give ~720 pushes/hour sustained and 10k/day
# — generous for personal use.
visitor-request-limit-burst: 200
visitor-request-limit-replenish: "5s"
visitor-message-daily-limit: 10000

# UnifiedPush payloads are tiny JSON (~1 KB); cap message size so any
# spam that gets through is cheap to drop.
message-size-limit: "4096"

# Anonymous attachments are the highest-leverage abuse vector and
# UnifiedPush never uses them. Hard caps for any authenticated upload too.
attachment-file-size-limit: "10M"
visitor-attachment-total-size-limit: "100M"
visitor-attachment-daily-bandwidth-limit: "500M"

# Short retention bounds the damage of anything that does slip through.
cache-duration: "12h"
