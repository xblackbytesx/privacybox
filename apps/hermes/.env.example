DOMAIN=privacy.box
SUBDOMAIN=hermes
HERMES_API_SUBDOMAIN=hermes-api
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Scoped Obsidian vault for the agent, a dedicated folder inside the syncthing
# tree, NOT your whole vault. Upstream advises against handing the agent every
# note on day one; widen it once you've seen how it behaves.
HERMES_VAULT_DIR=/media/storage/syncthing/obsidian/hermes

PUID=1000
PGID=1000

TIMEZONE=Europe/Amsterdam

# The web app (webapp.* in config.yaml) and its login live in the Hermes home,
# not here: ${DOCKER_ROOT}/hermes/data/config.yaml and .env (chmod 600). That
# .env holds HERMES_DASHBOARD_BASIC_AUTH_USERNAME, _PASSWORD and _SECRET
# (plaintext, Hermes hashes them; generate the secret with openssl rand -hex 32).

# Bearer key for the OpenAI-compatible API server. It grants the agent's full
# toolset, terminal included, so treat it like a shell password. The API router
# has no basic-auth: clients send this key in the Authorization header, which
# basic-auth would claim for itself. Hermes refuses to start the API server on a
# placeholder or a key under 16 characters.
# Generate by running openssl rand -hex 32
HERMES_API_KEY=secret

# Basic auth in front of the Hermes web app login. Any non-empty value
# enables it, so comment the line out to disable rather than setting it to
# false or 0. Hermes has its own login, so dropping this leaves one gate.
HERMES_BASIC_AUTH=1
