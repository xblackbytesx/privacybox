DOMAIN=privacy.box
SUBDOMAIN=hermes
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Scoped Obsidian vault for the agent, a dedicated folder inside the syncthing
# tree, NOT your whole vault. Upstream advises against handing the agent every
# note on day one; widen it once you've seen how it behaves.
HERMES_VAULT_DIR=/media/storage/syncthing/obsidian/hermes

PUID=1000
PGID=1000

TIMEZONE=Europe/Amsterdam

# Dashboard basic auth, Hermes's own gate, which sits behind Traefik's
# basic-auth@file as a second, independent layer. Plaintext here: Hermes hashes
# these internally, so unlike apps/traefik/.env this is NOT bcrypt.
HERMES_DASHBOARD_USER=hermes
HERMES_DASHBOARD_PASS=secret

# Generate by running openssl rand -hex 32
HERMES_DASHBOARD_SECRET=secret
