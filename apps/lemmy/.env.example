DOMAIN=privacy.box
SUBDOMAIN=lemmy
CERT_RESOLVER=transip-dns

DOCKER_ROOT=/media/storage/docker

DB_USER_PASS=secret
PICTRS_API_KEY=secret

# NOTE: lemmy.hjson is NOT templated from this file. After setting the values
# above you must copy lemmy.example.hjson to lemmy.hjson and repeat the
# password, the pictrs key and the ${SUBDOMAIN}.${DOMAIN} hostname there by
# hand. See docs/lemmy.md.
