DOMAIN=privacy.box
SUBDOMAIN=romm
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Valid example for library on local storage
MEDIA_DRIVER_OPT_TYPE=none
MEDIA_DRIVER_OPT_O=bind

# The library root. RomM expects a 'roms' folder inside it, and optionally a
# sibling 'bios' folder for firmware. See docs/romm.md for the full layout.
LIBRARY_ROOT="/media/storage/emulation"

# # Valid values for library on remote storage (NFS)
# MEDIA_DRIVER_OPT_TYPE=nfs4
# MEDIA_DRIVER_OPT_O="addr=<NFS_SERVER_IP>,rw"
# LIBRARY_ROOT=":/volume1/emulation"

DB_NAME=romm
DB_USER=romm
DB_USER_PASS=secret

# Generate a key with `openssl rand -hex 32`
SECRET_KEY=

##########################
## METADATA PROVIDERS   ##
##########################
# Hasheous is enabled in docker-compose.yml and needs no account.
# Everything below is optional, each one adds coverage or artwork.

# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Free account at https://www.screenscraper.fr, best retro coverage
SCREENSCRAPER_USER=
SCREENSCRAPER_PASSWORD=

# https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# https://retroachievements.org/controlpanel.php
RETROACHIEVEMENTS_API_KEY=

# https://www.mobygames.com/info/api/
MOBYGAMES_API_KEY=
