DOMAIN=privacy.box
SUBDOMAIN=kagami
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# A release (0.1.0), a series (0.1) or latest
KAGAMI_VERSION=latest

DB_PASSWORD=secret

# generate using `openssl rand -base64 32`
# Encrypts provider API keys at rest. Keep a copy with your backups:
# without it stored keys are unreadable and must be entered again.
KAGAMI_SECRET_KEY=

# Optional: set to "false" only if running without HTTPS (not recommended for production)
KAGAMI_COOKIE_SECURE=true
