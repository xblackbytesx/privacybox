DOMAIN=privacy.box
SUBDOMAIN=traefik
CERT_RESOLVER=transip-dns

LETSENCRYPT_EMAIL=john.doe@privacy.box

TRANSIP_ACCOUNT_NAME=someone
CLOUDFLARE_API_TOKEN=secret

# Username: traefik
# Pass: secret
AUTH_USER=traefik
AUTH_PASS=$$2y$$05$$CxOVwmGtNDSJnhrRq.r9neoaiuJwIvERsr9SvPF.8x4X5Mcha8Rdy

# Basic auth in front of the Traefik dashboard. Any non-empty value enables it,
# so comment the line out to disable rather than setting it to false or 0. The
# dashboard has no login of its own, so this is its only gate. Keep it on.
TRAEFIK_BASIC_AUTH=1
