# Peer name as it appears in the dashboard. Set explicitly rather than relying
# on the host's hostname: a compose-level `hostname:` key cannot be combined
# with network_mode: host, so NB_HOSTNAME is the way to name this peer.
NB_HOSTNAME=truenas

NB_MANAGEMENT_URL=https://netbird.privacy.box

# Dashboard, Setup Keys, Create Setup Key. A one-off key is enough for a single
# machine; make it reusable only if you expect to re-register this peer.
NB_SETUP_KEY=REPLACE_ME

# Wherever container data lives on this box; on TrueNAS that is a pool path
# rather than the VPS layout.
DOCKER_ROOT=/mnt/tank/docker
